{
  "name": "relquay",
  "version": "0.4.7",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "theme": "node scripts/make-dark.mjs",
    "build": "node scripts/make-dark.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/check-ui.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:build": "bash scripts/build-android.sh",
    "server:package": "node scripts/package-server.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.0.1",
    "@capacitor/browser": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "express": "5.1.0",
    "http-proxy-middleware": "3.0.5",
    "lucide-react": "0.468.0",
    "multer": "2.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "smol-toml": "1.9.1",
    "ws": "8.18.3",
    "yaml": "2.9.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
