# Export these values before starting the gateway (no automatic dotenv loading).
STUDIO_BASE=/home/ubuntu/workspace
STUDIO_STATE=/home/ubuntu/.local/share/roamdeck/state
STUDIO_HOST=127.0.0.1
STUDIO_PORT=3080
STUDIO_ORIGIN=https://workspace.example.com:28443
CLOUDCLI_URL=http://127.0.0.1:3001
# Optional trusted-proxy file manager and shell environment.
# FILEBROWSER_URL=http://127.0.0.1:3081
# STUDIO_ENV_FILE=/home/ubuntu/workspace/env.sh
